# Supabase Project URL (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon/Publishable Key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Service Role Key — NEVER expose this to the browser or commit it
# Used only in server-side code (API routes, seed scripts, migrations)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Google Gemini API Key — NEVER expose to browser, server-side only
GEMINI_API_KEY=your_gemini_api_key_here

# Branding & domain — update these when switching subdomains
NEXT_PUBLIC_SITE_NAME=Your Academy Name
NEXT_PUBLIC_SITE_TAGLINE=Elevate your sales performance
NEXT_PUBLIC_SITE_URL=https://your-subdomain.example.com
NEXT_PUBLIC_SUPPORT_WHATSAPP=9230000000000
